{
  "name": "codie-game-buddy",
  "version": "0.1.17",
  "private": true,
  "description": "Codie keeps you company while you play: it watches your game and comments on it",
  "type": "module",
  "main": "src/main/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "e2e": "playwright test",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "cn.code27.codie-game-buddy",
    "productName": "Codie Game Buddy",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "!node_modules/codie-host/{docs,spike,test}${/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "CodieGameBuddySetup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codie Game Buddy"
    },
    "publish": {
      "provider": "generic",
      "url": "https://git.service.code27.cn/codie/releases/~raw/main/game-buddy",
      "useMultipleRangeRequest": false
    }
  },
  "dependencies": {
    "codie-host": "file:../codie_host",
    "electron-updater": "6.8.11",
    "get-windows": "9.3.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.7.2",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "electron@44.7.2": true
  },
  "license": "UNLICENSED"
}
