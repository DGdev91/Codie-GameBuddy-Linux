{
  "name": "codie-host",
  "version": "0.1.0",
  "private": true,
  "description": "One local daemon that connects computer-side tools to Codie devices",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codie": "bin/codie.mjs",
    "codie-agentd": "bin/codie-agentd.mjs"
  },
  "exports": {
    ".": "./sdk/index.mjs",
    "./session": "./session/index.mjs",
    "./agentd": "./src/agentd/main.mjs",
    "./testing": "./testing/index.mjs"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/agentd/*.test.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  },
  "license": "UNLICENSED"
}
